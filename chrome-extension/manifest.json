{
  "manifest_version": 3,
  "name": "妙手模板与草稿助手",
  "version": "1.2.7",
  "description": "同步 TEMU 全托管店铺与模板，并在发布助手明确请求时创建未发布草稿。",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://erp.91miaoshou.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "妙手模板只读同步",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开妙手模板与草稿助手"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.91miaoshou.com/*"
      ],
      "js": [
        "template-draft-core.js",
        "erp-page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://erp.91miaoshou.com/*"
      ],
      "js": [
        "erp-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://yanyujie-upload-item-d1ab8962386-1465086870.tcloudbaseapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "publisher-content.js"
      ],
      "run_at": "document_start"
    }
  ]
}

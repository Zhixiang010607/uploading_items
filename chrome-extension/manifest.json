{
  "manifest_version": 3,
  "name": "妙手模板只读同步",
  "version": "1.1.0",
  "description": "从已登录的妙手 ERP 只读同步 TEMU 全托管店铺、产品模板和 SKU 模板。",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "妙手模板只读同步",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.91miaoshou.com/*"
      ],
      "js": [
        "erp-page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://erp.91miaoshou.com/*"
      ],
      "js": [
        "erp-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://yanyujie-upload-item-d1ab8962386-1465086870.tcloudbaseapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "publisher-content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
